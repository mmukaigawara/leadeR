Package: leadeR
Title: Profiling Leaders at a Distance
Version: 0.1.0
Authors@R: c(
    person(given = "Mitsuru", family = "Mukaigawara", 
           email = "mitsuru_mukaigawara@g.harvard.edu", 
           role = c("cre", "aut"),
           comment = c(ORCID = "0000-0001-6530-2083")),
